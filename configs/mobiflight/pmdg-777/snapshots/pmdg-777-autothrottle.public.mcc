    <config guid="f5fc1143-e247-416a-9c89-27c4795a37ee">
      <active>true</active>
      <description>LCD</description>
      <settings msdata:InstanceType="MobiFlight.OutputConfigItem, MFConnector, Version=10.5.3.0, Culture=neutral, PublicKeyToken=null" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
        <source type="SimConnect" VarType="CODE" Value="(L:switch_498_a)" UUID="-" />
        <test type="Float" value="1" />
        <modifiers>
          <comparison active="False" value="0" operand="=" ifValue="retracted" elseValue="$" />
          <comparison active="False" value="200" operand="=" ifValue="armed" elseValue="$" />
        </modifiers>
        <display type="LcdDisplay" serial="MF UNO MCP/ SN-PUB-MCP" trigger="normal" address="LcdDisplay">
          <line>splrs:!!!!!!!!!!</line>
          <line>at:   ##########</line>
        </display>
        <preconditions />
        <configrefs>
          <configref active="True" ref="f03435c9-8727-4ee5-bc7c-56a537c770b1" placeholder="#" testvalue="1" />
          <configref active="True" ref="64af7adb-324b-473f-92c2-81e50e4b9597" placeholder="!" testvalue="1" />
        </configrefs>
      </settings>
    </config>
